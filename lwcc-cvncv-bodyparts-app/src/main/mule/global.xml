<?xml version="1.0" encoding="UTF-8"?>

<mule
	xmlns:tls="http://www.mulesoft.org/schema/mule/tls"
	xmlns:anypoint-mq="http://www.mulesoft.org/schema/mule/anypoint-mq"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:secure-properties="http://www.mulesoft.org/schema/mule/secure-properties"
	xmlns:json-logger="http://www.mulesoft.org/schema/mule/json-logger"
	xmlns:salesforce="http://www.mulesoft.org/schema/mule/salesforce"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/salesforce http://www.mulesoft.org/schema/mule/salesforce/current/mule-salesforce.xsd
http://www.mulesoft.org/schema/mule/json-logger http://www.mulesoft.org/schema/mule/json-logger/current/mule-json-logger.xsd
http://www.mulesoft.org/schema/mule/secure-properties http://www.mulesoft.org/schema/mule/secure-properties/current/mule-secure-properties.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/anypoint-mq http://www.mulesoft.org/schema/mule/anypoint-mq/current/mule-anypoint-mq.xsd
http://www.mulesoft.org/schema/mule/tls http://www.mulesoft.org/schema/mule/tls/current/mule-tls.xsd">
	<salesforce:sfdc-config
		name="Salesforce_Config_Intergration" doc:name="Salesforce Config"
		doc:id="a79b34b1-8993-4f70-8ddf-a044b5f47e93">
		<salesforce:jwt-connection
			consumerKey="${secure::sfdc.consumerkey}" keyStore="${mule.env}-jks.jks"
			storePassword="${secure::sfdc.password}"
			certificateAlias="${sfdc.alias}" principal="${sfdc.principal}"
			tokenEndpoint="${sfdc.endpoint}" audienceUrl="${sfdc.audience}">
			<reconnection>
				<reconnect-forever frequency="5000" />
			</reconnection>
		</salesforce:jwt-connection>
	</salesforce:sfdc-config>
	<json-logger:config name="JSON_Logger_Config"
		doc:name="JSON Logger Config"
		doc:id="86160e82-b6df-454a-800f-c2b35000d3fb"
		environment="${mule.env}" />

	<configuration-properties
		doc:name="regular-env-properties"
		doc:description="Environment specific regular properties"
		doc:id="06cd8c9d-fb59-43e0-b3fa-2f04c4f8c8f5"
		file="properties/${mule.env}-config.yaml" />

	<configuration-properties
		doc:name="base-common-properties"
		doc:description="Common Base Properties - Environment independent"
		doc:id="6a12256e-f03a-4d4c-a2e9-c5a2cbd79377"
		file="properties/common-config.yaml" />
	
	<secure-properties:config
		name="secure-env-properties" doc:name="Secure Environment Properties"
		doc:id="005c7735-6225-495e-84a0-f963bf03baeb"
		file="properties/secure-${mule.env}-config.yaml" key="${secure.key}"
		doc:description="Environment specific secured properties">
</secure-properties:config>
	<configuration doc:name="Configuration" doc:id="130b1af7-3539-4b3f-b2d5-678e768cb5d5" defaultErrorHandler-ref="globalError_Handler" />
	<http:request-config name="HTTP_Request_conf_claims_prc_api" doc:name="HTTP Request configuration" doc:id="cc50776e-39cf-4095-b590-4bdde9737bbe" basePath="${claims.basepath}" responseTimeout="${connector.response.timeout}">
		<http:request-connection host="${claims.host}" port="${claims.port}" protocol="HTTPS"/>
	</http:request-config>
	<anypoint-mq:config name="Anypoint_MQ_Config" doc:name="Anypoint MQ Config" doc:id="9afd66e5-b85c-439d-aa6c-667d18014427" >
		<anypoint-mq:connection url="${mq.url}" clientId="${secure::mq.client_id}" clientSecret="${secure::mq.client_secret}" />
	</anypoint-mq:config>
	<http:request-config name="HTTP_Request_conf_int-logs-sfdc-sys-api" doc:name="HTTP Request configuration" doc:id="f8a2c4d1-9e5b-4f3a-b6c7-8d9e0f1a2b3c" basePath="${httpReq.integ.basepath}" responseTimeout="${connector.response.timeout}">
		<http:request-connection protocol="HTTPS" host="${httpReq.integ.host}" port="${httpReq.integ.port}">
			<reconnection>
				<reconnect frequency="${httpReq.integ.reconnection.frequency}" count="${httpReq.integ.reconnection.attempts}" />
			</reconnection>
			<tls:context>
				<tls:trust-store insecure="true" />
			</tls:context>
		</http:request-connection>
	</http:request-config>
</mule>
