	<sub-flow name="put-payees-record-sub-flow" doc:id="ba3f8a88-8f14-4931-b701-8722ba57bb35" >
		<ee:transform doc:name="Set Payee Id" doc:id="a011354d-454f-4973-bb55-6762e0b0dd02">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="payeeRecordId"><![CDATA[%dw 2.0
output application/json
---
payload.benefitPayeeRecordId]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="get-claim-payee-id-sub-flow" doc:id="cdfc7bad-5b8a-4916-b5f3-a5270b74b5d9" name="get-claim-payee-id-sub-flow"/>
		<flow-ref doc:name="get-payees-sub-flow" doc:id="e8d7833a-cd82-4430-ae99-57e6500b4bc6" name="get-payees-sub-flow" />
		<ee:transform doc:name="set Benefit and claim Id" doc:id="07befa22-f2e7-4449-a1cd-8465fbff5e50">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="benefitRecordId" ><![CDATA[%dw 2.0
output application/json
---
 vars.getPayees[0].dtBenefits]]></ee:set-variable>
				<ee:set-variable variableName="claimRecordId" ><![CDATA[%dw 2.0
output application/json
---
vars.getPayees[0].dtClaim]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="get-benefits-sub-flow" doc:id="5587d23f-3860-4562-a46c-9943e0d718ba" name="get-benefits-sub-flow" />
		<flow-ref doc:name="get-claims-sub-flow" doc:id="fd00b040-b143-49a8-b28e-dd8dd2edeabc" name="get-claims-sub-flow" />
		<ee:transform doc:name="Prepare payload for lagniappe" doc:id="1fbedb38-3b2f-44d8-a1c3-f2b0cfb1b786" >
			<ee:message >
				<ee:set-payload resource="transforms/dwl/p-updatePayeeRequest.dwl" />
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="patch-benefits-sub-flow" doc:id="afa8e856-9bdf-42e2-bb8f-1db52b202a74" name="patch-benefits-sub-flow" />
	</sub-flow>
