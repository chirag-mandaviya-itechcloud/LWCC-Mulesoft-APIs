    <flow name="benefits-prc-api-main">
        <http:listener config-ref="HTTP_Listener_config" path="/api/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <ee:transform doc:name="Set correlation-id" doc:id="79327c48-077c-4122-87bc-590e5cd63d3c">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="correlationId"><![CDATA[%dw 2.0
output application/json
---
attributes.headers.'x-correlation-id' as String default ""]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<apikit:router config-ref="benefits-prc-api-config" />
		<error-handler ref="api-common-error-handler" />
    </flow>
