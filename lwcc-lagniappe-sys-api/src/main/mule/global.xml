    <secure-properties:config name="secure-env-properties" doc:name="Secure Environment Properties" doc:id="ac09402e-d197-4ce5-8718-de9c0b19afc3" file="properties/secure-${mule.env}-config.yaml" key="${secure.key}" doc:description="Environment specific secured properties" />
    <http:listener-config name="lagniappe-sys-api-httpListenerConfig">
        <http:listener-connection host="localhost" port="${http.port}" />
    </http:listener-config>
    <http:request-config name="HTTPS_Request_configuration" doc:name="HTTP Request configuration" doc:id="0c474de4-8334-43f8-9d86-7ab82e4331fc">
        <http:request-connection host="${httpsRequest.host}" port="${httpsRequest.port}" protocol="HTTPS">
            <reconnection>
                <reconnect frequency="${httpsRequest.reconnection.frequency}" count="${httpsRequest.reconnection.attempts}" />
            </reconnection>
            <tls:context>
                <tls:trust-store insecure="true" />
            </tls:context>
        </http:request-connection>
    </http:request-config>
    <http:request-config name="HTTP_Request_conf_int-logs-sfdc-sys-api" doc:name="HTTP Request configuration" doc:id="50cc272b-c81f-43cb-ade6-f9c16e50c645" basePath="${httpReq.integ.basepath}">
		<http:request-connection protocol="HTTPS" host="${httpReq.integ.host}" port="${httpReq.integ.port}">
			<tls:context>
				<tls:trust-store insecure="true" />
			</tls:context>
		</http:request-connection>
	</http:request-config>
    <!-- api-gateway:autodiscovery apiId="${api.id}" ignoreBasePath="true" doc:name="API Autodiscovery" doc:id="f29e01bc-e660-428d-b8b5-1d4dfdd7f384" flowRef="lagniappe-sys-api-main" -->
