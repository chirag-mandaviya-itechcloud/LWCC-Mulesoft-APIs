    <configuration-properties doc:name="regular-env-properties" doc:description="Environment specific regular properties" doc:id="07cbb24e-90a7-4e9c-b20b-6009408ce6d8" file="properties/${mule.env}-config.yaml" />
    <!-- Common base properties -->
    <configuration-properties doc:name="base-common-properties" doc:description="Common Base Properties - Environment independent" doc:id="f56a469d-bfc5-4446-8780-df31820ecb72" file="properties/common-config.yaml" />
