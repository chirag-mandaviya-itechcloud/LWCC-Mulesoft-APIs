                <db:column-type id="2008" typeName="PKG_DGTL_CLM_INVSTG_INTFC.CLM_INV_IW_RSPN_TBL" />
                <db:column-type id="2008" typeName="PKG_DGTL_CLM_INVSTG_INTFC.CLM_CNTC_COMNT_TBL" />
