#%RAML 1.0 Trait

usage: Apply this trait to endpoints requiring client authentication
headers:
  client_id:
    type: string
    description: Client application ID for authentication
    required: true
  client_secret:
    type: string
    description: Client application secret for authentication
    required: true
responses:
  401:
    description: Unauthorized or invalid client application credentials
    body:
      application/json:
        example: |
          {
            "errorCode": "UNAUTHORIZED",
            "errorMessage": "Invalid client credentials",
            "errorDescription": "The provided client_id or client_secret is invalid",
            "transactionId": "abc-123-xyz",
            "timeStamp": "2026-01-22T12:00:00Z"
          }
  500:
    description: Bad response from authorization server
    body:
      application/json:
        example: |
          {
            "errorCode": "SERVER_ERROR",
            "errorMessage": "Authorization server error",
            "errorDescription": "Unable to validate client credentials",
            "transactionId": "abc-123-xyz",
            "timeStamp": "2026-01-22T12:00:00Z"
          }
