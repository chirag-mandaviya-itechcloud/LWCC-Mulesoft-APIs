#%RAML 1.0 DataType

description: Request body for document split operation
type: object
properties:
  claimId:
    description: Salesforce Claim ID
    type: string
    required: true
    minLength: 15
    maxLength: 18
    pattern: "^[a-zA-Z0-9]{15,18}$"
    example: "0ZkVA000000Ubyn0AC"
  documentId:
    description: Salesforce Document ID (ContentDocument ID)
    type: string
    required: true
    minLength: 15
    maxLength: 18
    pattern: "^[a-zA-Z0-9]{15,18}$"
    example: "069VA00000CB2CTYA1"
  forceRefresh:
    description: Force refresh flag (defaults to true if not provided)
    type: boolean
    required: false
    default: true
    example: true
